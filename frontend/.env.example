# Base URL of the API gateway. The frontend only ever talks to the gateway, never to a service directly.
VITE_API_BASE_URL=http://localhost:8080

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# How long (ms) to keep retrying safe requests while sleeping backends wake up (e.g. Render free tier).
# 0 disables retries and the wake-up ping, which is right for local development.
VITE_WAKE_RETRY_WINDOW_MS=0
